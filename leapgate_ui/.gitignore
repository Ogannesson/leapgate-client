# The repository's root .gitignore ignores *png, *svg and *jpg; this tree keeps its own.
!*.png
!*.svg
!*.jpg

# Flutter and Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# flutter_rust_bridge output, regenerated by every build (scripts/windows/build-client.ps1 -Ui leapgate)
core/lib/generated_bridge*.dart
core/bridge_generated*.h

# Generated by flutter pub get (gen-l10n and plugin registration)
app/lib/l10n/app_localizations*.dart
**/flutter/generated_plugin_registrant.*
**/flutter/generated_plugins.cmake
